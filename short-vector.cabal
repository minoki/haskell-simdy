cabal-version:      3.0
name:               short-vector
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             ARATA Mizuki
maintainer:         minorinoki@gmail.com
-- copyright:
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wcompat -fllvm

library
    import:           warnings
    exposed-modules:  Data.ShortVector.Class
                      Data.ShortVector.Internal.NoSIMD
                      Data.ShortVector.Internal.SIMD128
                      Data.ShortVector.Unboxed
    other-modules:    Data.ShortVector.Class.Generated
                      Data.ShortVector.Internal.NoSIMD.X2
                      Data.ShortVector.Internal.NoSIMD.X4
                      Data.ShortVector.Internal.NoSIMD.X8
                      Data.ShortVector.Internal.NoSIMD.X16
                      Data.ShortVector.Internal.NoSIMD.X32
                      Data.ShortVector.Internal.SIMD128.X2
                      Data.ShortVector.Internal.SIMD128.X4
                      Data.ShortVector.Internal.SIMD128.X8
                      Data.ShortVector.Internal.SIMD128.X16
                      Data.ShortVector.Internal.SIMD128.X32
    -- other-extensions:
    build-depends:    base >=4.18.0.0 && <4.21,
                      primitive ^>=0.9.0.0,
                      vector ^>=0.13.1.0
    hs-source-dirs:   src
    default-language: GHC2021

test-suite short-vector-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >=4.18.0.0 && <4.21,
        short-vector
