                    , arch-options
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    main-is:          cbits/test_double_minmax.c
    build-depends:    simdy,
                      simdy:vl128-c,
                      simdy:vl256-c,
                      simdy:vl512-c

library matmul
    import:           warnings
                    , arch-options
    exposed-modules:  MatMul
    hs-source-dirs:   example/matmul
    build-depends:    base >=4.19.0.0 && <4.24,
                      simdy,
                      simdy:plugin,
                      vector ^>=0.13.1.0,
                      deepseq
    default-language: GHC2021

    if flag(llvm)
        ghc-options: -fllvm

        if flag(avx512) && os(darwin) && impl(ghc == 9.14.1)
