            -- See https://gitlab.haskell.org/ghc/ghc/-/issues/26410
            ghc-options: -optlc -mattr=+evex512

test-suite simdy-test-matmul
    import:           warnings
                    , arch-options
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   example/matmul-test
    main-is:          Main.hs
    build-depends:    base >=4.19.0.0 && <4.24,
